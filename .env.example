POSTGRES_USER=mocksathi
POSTGRES_PASSWORD=mocksathi
POSTGRES_DB=mocksathi
POSTGRES_PORT=5432

# Local Docker Postgres by default. For a hosted database (Supabase, etc.),
# see the "Hosted Postgres" note in README.md — DATABASE_URL should be the
# pooler connection there, with MIGRATION_DATABASE_URL set separately to the
# direct connection for db:migrate/db:generate.
DATABASE_URL=postgres://mocksathi:mocksathi@localhost:5432/mocksathi
# MIGRATION_DATABASE_URL=

DRIZZLE_GATEWAY_PASSWORD=mocksathi
DRIZZLE_GATEWAY_PORT=4983

# How long a session lasts before the cookie/DB row expires and the holder is
# sent back to /login. Hours, fractional allowed (e.g. 0.5 for 30 minutes).
SESSION_DURATION_HOURS=1

# How many sessions (devices/browsers) one user may be signed into at once.
# Signing in past this quietly signs out the oldest one, rather than growing
# the sessions table without bound.
MAX_CONCURRENT_SESSIONS=5

# Supabase. The publishable key is safe in the browser (governed by row-level
# security) — never put the secret key (sb_secret_...) here or behind a
# NEXT_PUBLIC_ prefix; it bypasses row-level security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Storage, server-only (src/utils/supabase/admin.ts) — profile photo
# uploads. The service_role key, never NEXT_PUBLIC_ — it bypasses row-level
# security entirely. Also requires a public "avatars" Storage bucket to exist
# (Dashboard -> Storage -> New bucket, name "avatars", Public bucket: on).
SUPABASE_SERVICE_ROLE_KEY=

# Google Sign-In (sdd/google-signin.md) — a Google Cloud Console OAuth Client
# ID (Web application), with http://localhost:3000/api/auth/google/callback
# (and your production domain's equivalent) as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend, for verification emails (src/email/resend.ts). The API key from
# resend.com -> API Keys. Server-only: never give it a NEXT_PUBLIC_ prefix, and
# never commit the real value. The sender is Mocksathi <verify@mocksathi.com>,
# which requires mocksathi.com to be a verified domain in Resend.
RESEND_API_KEY=
