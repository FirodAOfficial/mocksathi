POSTGRES_USER=mocksathi
POSTGRES_PASSWORD=mocksathi
POSTGRES_DB=mocksathi
POSTGRES_PORT=5432

# Local Docker Postgres by default. For a hosted database (Supabase, etc.),
# see the "Hosted Postgres" note in README.md — DATABASE_URL should be the
# pooler connection there, with MIGRATION_DATABASE_URL set separately to the
# direct connection for db:migrate/db:generate.
DATABASE_URL=postgres://mocksathi:mocksathi@localhost:5432/mocksathi
# MIGRATION_DATABASE_URL=

DRIZZLE_GATEWAY_PASSWORD=mocksathi
DRIZZLE_GATEWAY_PORT=4983

# How long a session lasts before the cookie/DB row expires and the holder is
# sent back to /login. Hours, fractional allowed (e.g. 0.5 for 30 minutes).
SESSION_DURATION_HOURS=1

# Supabase. The publishable key is safe in the browser (governed by row-level
# security) — never put the secret key (sb_secret_...) here or behind a
# NEXT_PUBLIC_ prefix; it bypasses row-level security entirely.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
